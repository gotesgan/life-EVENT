# ---------------------------------------------------------------------------
# Copy to `.env` and fill in real values. Never commit real secrets.
#
# NODE_ENV is provided by the runtime (development | test | production) and is
# validated by src/lib/env.ts; it is not normally set here.
# ---------------------------------------------------------------------------

# PostgreSQL. In production this is Neon:
#   DATABASE_URL -> pooled endpoint (PgBouncer), used by the application
#   DIRECT_URL   -> direct endpoint, used by `prisma migrate`
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public&sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/dbname?schema=public&sslmode=require"

# Isolated database used only by integration/API tests (`pnpm test:integration`).
TEST_DATABASE_URL="postgresql://user:password@host:5432/dbname_test?schema=public"

# Public origin of the application. Used for canonical URLs, sitemap and
# Better Auth callback URLs.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Better Auth. BETTER_AUTH_SECRET must be a long random string
# (`openssl rand -base64 32`). Server-only.
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Cloudflare R2 media storage. Server-only.
# Leave R2_* unset in local development to use the local filesystem driver.
#
# In NODE_ENV=production the application refuses to start without either a full
# R2 configuration or the explicit opt-in below, because a silent fallback to the
# filesystem writes media to an ephemeral disk and serves 404s for every image.
# Set ALLOW_LOCAL_MEDIA_STORAGE=true only where a persistent disk really exists
# (a container with a mounted volume, or CI).
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# Public CDN/bucket domain that serves listing media (no trailing slash).
R2_PUBLIC_BASE_URL=""
# Optional: custom endpoint for R2 (defaults to https://<account>.r2.cloudflarestorage.com)
R2_ENDPOINT=""

# Explicit opt-in to the local filesystem storage driver in production.
ALLOW_LOCAL_MEDIA_STORAGE="false"

# Maximum accepted upload size in bytes (5 MiB by default).
MEDIA_MAX_UPLOAD_BYTES="5242880"

# Salt used to hash submitter IP addresses before storage (no raw IP is kept).
IP_HASH_SALT="replace-with-a-random-salt"

# How many proxies in front of the application you control. `x-forwarded-for` is
# a chain a client can prepend to, so the client address is counted from the END
# of the list, not the first entry. 1 suits a single managed platform proxy
# (Vercel's edge). Raise it if you add your own proxy in front.
TRUSTED_PROXY_HOPS="1"

# Rate limiting windows (requests per window, window in seconds).
RATE_LIMIT_ENQUIRY_PER_IP="5"
RATE_LIMIT_ENQUIRY_PER_EMAIL="3"
RATE_LIMIT_AUTH_PER_IP="20"
RATE_LIMIT_WINDOW_SECONDS="900"
