# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# prisma
# The client is generated code, reproducible with `pnpm db:generate`.
/src/generated/

# local media driver output (development/test only)
/.local-storage/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the documented template must ship.
!.env.example
!.env.example

# machine-specific local shims (cache/store paths, local DB URLs)
.dev-env.sh

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Research screenshots and Playwright artefacts: ~93MB of PNGs kept on disk as the
# visual record (docs/research/shots, test-results/visual) but not committed.
# The markdown reports in docs/research/ ARE committed.
/docs/research/shots/
/docs/research/tools/

# UI review captures and the Playwright MCP scratch directory. Regenerated by
# `scripts/capture-ui-review*.mts`; the findings live in docs/master-ui-redesign-plan.md.
/docs/ui-review/
/.playwright-mcp/
